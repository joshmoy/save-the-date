# Platform: a separate database from the legacy wedding.
# API and worker read these values from the root .env automatically.
DB_ADAPTER=postgres
DB_CONNECTION=postgresql://josh@127.0.0.1:55439/std_test
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
API_PORT=4000
WEB_PORT=3000
# Legacy single secret is supported. Rolling format: {"active":"next","keys":{"previous":"32+ character secret","next":"different 32+ character secret"}}
TOKEN_HASH_KEYS=development-only-replace-with-32-random-bytes
STORAGE_ADAPTER=filesystem
STORAGE_NAMESPACE=weddings
STORAGE_ROOT=/tmp/std-storage
# Total originals plus processed files. Per-file pilot limits are enforced by the API.
MEDIA_STORAGE_BYTES=10737418240
# Optional S3-compatible adapter settings; keep the bucket private.
S3_BUCKET=

# S3_ENDPOINT=https://your-object-store.example.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional maintained host codec binaries. Packaged codecs are used locally by default.
# MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
# MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
EMAIL_ADAPTER=capture
EMAIL_CAPTURE_ROOT=/tmp/std-mail
EMAIL_FROM=local@example.test
# For external Raven Relay verification choose EMAIL_ADAPTER=ravenrelay.
# EMAIL_FROM must use the exact verified sender domain.
RAVENRELAY_API_URL=https://api-production-1c6a.up.railway.app
RAVENRELAY_API_KEY=
RAVENRELAY_PROJECT_ID=
RAVENRELAY_WEBHOOK_SECRET=
LLM_ADAPTER=disabled
IMAGE_ADAPTER=disabled
JOB_TRANSPORT=postgres
# Production must use explicit policy identifiers and a durable storage root.
# RETENTION_POLICY=pilot-12-months-plus-30-days
# BACKUP_POLICY=encrypted-30-day-pitr

# Legacy wedding only; the platform does not use DATABASE_URL.
DATABASE_URL=
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret
MAILEROO_API_KEY=
MAILEROO_FROM_EMAIL=passes@your-verified-domain.com
MAILEROO_FROM_NAME=Adeola & Joshua
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wedding
R2_PUBLIC_URL=https://media.example.com

# Invitation render worker: pinned maintained Chromium/Chrome with sandbox support.
INVITATION_BROWSER_PATH=/usr/bin/chromium
# Optional override; defaults to bundled packages/templates/assets.
# INVITATION_FONT_DIRECTORY=/opt/save-the-date/packages/templates/assets

# Admission payload encryption: JSON object of key IDs to base64 32-byte keys.
# First key seals new payloads; retain old keys until active payloads are rotated.
# Generate locally with: node -e "console.log(JSON.stringify({v1:require('crypto').randomBytes(32).toString('base64')}))"
# ADMISSION_ENCRYPTION_KEYS={"v1":"<base64-32-byte-key>"}

# Guest uploads remain private and fail safety processing when the scanner is disabled.
# Private clamd must support INSTREAM and StreamMaxLength >= 250M.
MEDIA_MALWARE_ADAPTER=disabled
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# AI stays disabled by default; manual concepts/boards/briefs remain usable.
# Select supported models explicitly and configure honest operator estimates before paid generation.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=
OPENAI_IMAGE_MODEL=
AI_CONCEPT_RUNS_PER_DAY=3
AI_BOARD_RUNS_PER_DAY=1
AI_CONCEPT_CREDITS=1
AI_BOARD_CREDITS=5
# AI_CONCEPT_ESTIMATE_USD=0.00
# AI_BOARD_ESTIMATE_USD=0.00

# Durable deletion ledger: exclude from normal database/object rollback.
# Filesystem: mount this on a separately retained private volume.
DELETION_LEDGER_ROOT=.local/deletion-ledger
# S3 production: use a separate private bucket with independent backup/retention.
DELETION_LEDGER_S3_BUCKET=

# Verified account UUID allowlist, independent of wedding roles; empty disables operator access.
OPERATOR_USER_IDS=
# Public support email; example.test addresses are hidden, while /support reports still work locally.
SUPPORT_EMAIL=support@example.test

# Optional dedicated, private renderer service when the worker host cannot run sandboxed Chromium.
# Leave empty to launch the local INVITATION_BROWSER_PATH executable.
# RENDER_BROWSER_ENDPOINT=http://127.0.0.1:9223
# RENDER_BROWSER_PORT=9223
# Isolated local S3 conformance service only (scripts/verify-storage.ts).
# TEST_S3_ENDPOINT=http://127.0.0.1:59000
# TEST_S3_ACCESS_KEY_ID=
# TEST_S3_SECRET_ACCESS_KEY=

# Operational encrypted backups. Choose a genuinely independent replica destination in production.
# BACKUP_ROOT=/data/backups
# BACKUP_REPLICA_ROOT=/independent-volume/backups
# BACKUP_ENCRYPTION_KEYS={"active":"v1","keys":{"v1":"BASE64_32_RANDOM_BYTES"}}
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
# Restore only to a distinct, empty target while old services are fenced.
# RESTORE_DB_CONNECTION=postgresql://user:password@127.0.0.1:5432/std_restored_test
# RESTORE_STORAGE_ROOT=/data/restored-storage
