{
  "name": "@save-the-date/templates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./website": {
      "types": "./dist/website-theme.d.ts",
      "import": "./dist/website-theme.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/qrcode": "^1.5.6"
  }
}
