# Independent platform configuration; never uses the legacy DATABASE_URL.
NODE_ENV=development
DB_ADAPTER=postgres
DB_CONNECTION=postgresql://josh@127.0.0.1:55439/std_test
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
PORT=4000
TOKEN_HASH_KEYS=development-only-replace-with-32-random-bytes
STORAGE_ADAPTER=filesystem
STORAGE_NAMESPACE=weddings
STORAGE_ROOT=/tmp/std-storage
EMAIL_ADAPTER=capture
EMAIL_CAPTURE_ROOT=/tmp/std-mail
EMAIL_FROM=local@example.test
LLM_ADAPTER=disabled
IMAGE_ADAPTER=disabled
JOB_TRANSPORT=postgres
# Production must use explicit policy identifiers and a durable storage root.
# RETENTION_POLICY=pilot-12-months-plus-30-days
# BACKUP_POLICY=encrypted-30-day-pitr
