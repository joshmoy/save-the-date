{
  "name": "save-the-date",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @save-the-date/web dev",
    "dev:api": "pnpm --filter @save-the-date/api dev",
    "dev:worker": "pnpm --filter @save-the-date/worker dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/platform-migrate.ts",
    "db:migrate:legacy": "node scripts/migrate.mjs",
    "db:legacy-report": "tsx scripts/legacy-report.ts",
    "user:create:legacy": "node scripts/create-user.mjs",
    "media:process-images": "node scripts/process-images.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "turbo": "^2.6.0",
    "tsx": "^4.20.0",
    "@types/pg": "^8.20.0",
    "@types/express": "^5.0.0",
    "@save-the-date/persistence": "workspace:*",
    "@save-the-date/config": "workspace:*",
    "@save-the-date/adapters": "workspace:*",
    "@save-the-date/contracts": "workspace:*",
    "@save-the-date/domain": "workspace:*"
  },
  "dependencies": {
    "pg": "^8.21.0",
    "dotenv": "^17.4.2"
  }
}
